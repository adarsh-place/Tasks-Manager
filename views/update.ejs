<%- include("partials/header") %>
  <body>
    <%- include("./partials/nav.ejs") %>
    <div class="table-container">
      <h2 class="task-title">Task list</h2>

      <table>
        <tr>
          <th>Title</th>
          <th>Deadline</th>
          <th>Created at</th>
          <th>Updated at</th>
          <th>Action</th>
        </tr>
        <tr>
          <% for(let i =0; i < tasks.length; i++) { %>
            <td><%= tasks[i].title %></td>
            <td><%= moment(tasks[i].deadlineDateTime).format("MMM DD, YYYY, HH:mm") %></td>
            <td><%= moment(tasks[i].createdAt).format("MMM DD, YYYY, HH:mm:ss")  %></td>
            <td><%= moment(tasks[i].updatedAt).format("MMM DD, YYYY, HH:mm:ss") %></td>
            <td>
              <a class="btn" href="/update-task?id=<%= tasks[i]._id %>">Edit</a>
              <a class="btn" href="/delete-task?id=<%= tasks[i]._id %>">Delete</a>
            </td>
        </tr>
          <% } %>    
      </table>
    </div>
    <%- include("partials/footer") %>
  </body>
</html>
