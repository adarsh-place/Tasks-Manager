<%- include("partials/header") %>
    
  <body>
    <div class="table-container">
      <h2 class="task-title">Delete Task : <%= task.title %></h2>

      <div class="confirm">
        <p>
          Are you sure you want delete this task?
        </p>
        <a class="btn" href="/confirm-delete?id=<%= id %>&confirm=yes">Yes</a>
        <a class="btn" href="/confirm-delete?id=<%= id %>&confirm=no">No</a>
      </div>
    </div>
  </body>
</html>