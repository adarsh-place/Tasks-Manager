<%- include("partials/header") %>
  <body>
    <%- include("./partials/nav.ejs") %>
    <div class="table-container">
      <h2 class="todo-title">Update Task</h2>

      <div>

        <form action="/update-task/<%= task._id %>" method="post">
          <div class="update-task">
            <div class="form-group">
              <label for="title" class="text-light">Title</label>
              <input
                type="text"
                name="title"
                value="<%= task.title %>"
                placeholder="Input task here"
              />
            </div>

            <div class="form-group">
              <label for="snippet" class="text-light">Snippet</label>
              <input
                type="text"
                name="snippet"
                value="<%= task.snippet %>"
                placeholder="Input short description here"
              />
            </div>

            <div class="form-group">
              <label for="desc" class="text-light">Description</label>
              <input
                type="text"
                name="desc"
                value="<%= task.desc %>"
                placeholder="Input description here"
              />
            </div>
            
            <div class="form-group">
              <label for="done" class="text-light">Completed</label>
              <input
                type="text"
                name="done"
                value="<%= task.done %>"
                placeholder="true/false"
              />
            </div>

            <div class="form-group">
              <label for="deadline_date" class="text-light">Deadline Date </label>
              <input
                type="date"
                name="deadline_date"
                value="<%= moment(task.deadlineDateTime).format('YYYY-MM-DD') %>"
                style="padding: 2px 5px 2px 5px;"
              />
              <br>
              <br>
            </div>

            <div class="form-group">
              <label for="deadline_time" class="text-light">Deadline Time </label>
              <input
                type="time"
                name="deadline_time"
                value="<%= moment(task.deadlineDateTime).format('HH:mm') %>"
                style="padding: 2px 5px 2px 5px;"
              />
              <br>
              <br>
            </div>

            <div class="form-group">
              <button type="submit" class="btn">Save</button>
              <a class="btn" href="/update">Back</a>
            </div>
          </div>
        </form>
      </div>
    </div>
    <%- include("partials/footer") %>
  </body>
</html>